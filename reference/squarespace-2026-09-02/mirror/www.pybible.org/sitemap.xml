  <url>
    <loc>https://www.pybible.org/en/whybilingual</loc>
    <changefreq>daily</changefreq>
    <priority>0.75</priority>
    <lastmod>2020-11-03</lastmod>
    <image:image>
      <image:loc>https://images.squarespace-cdn.com/content/v1/5f61761af2cdd54a05d788de/1602056235252-NNUN4L3G3XGOJT2FE3AK/ESL_class.jpg</image:loc>
      <image:title>Why Make It Bilingual? - Bible Stories in English and North Korean</image:title>
      <image:caption>In the era of re-unified Korea we anticipate limited yet critical opportunities in which Bible and its content can penetrate into daily life of North Korea citizens. We believe our English-North Korean Bilingual Bible can be used by missionaries and youth pastors teaching English as a second language.</image:caption>
    </image:image>
    <image:image>
      <image:loc>https://images.squarespace-cdn.com/content/v1/5f61761af2cdd54a05d788de/1602711908489-RH4MUSY189KU5KESO5L3/image-asset.jpeg</image:loc>
      <image:title>Why Make It Bilingual? - Beyond us and now</image:title>
      <image:caption>We believe our efforts are paving the way for emergence of improved Bible translations and better Bible teaching resources for the people of North Korea. Learn more about our mission.</image:caption>
    </image:image>
